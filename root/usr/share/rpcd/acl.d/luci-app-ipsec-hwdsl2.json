{
	"luci-app-ipsec-hwdsl2": {
		"description": "Grant ubus access for LuCI IPsec VPN (hwdsl2) management",
		"read": {
			"ubus": {
				"luci.ipsec_hwdsl2": [
					"container_status",
					"clients_list",
					"users_list",
					"client_download"
				]
			},
			"uci": [ "ipsec-hwdsl2" ]
		},
		"write": {
			"ubus": {
				"luci.ipsec_hwdsl2": [
					"client_add",
					"client_revoke",
					"client_delete",
					"user_add",
					"user_delete",
					"container_restart"
				]
			},
			"uci": [ "ipsec-hwdsl2" ]
		}
	}
}
